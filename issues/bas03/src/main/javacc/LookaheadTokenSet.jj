options
{
//  STATIC = false;
}

PARSER_BEGIN(LookaheadTokenSet)
package lts;

import java.io.FileInputStream;
import java.io.FileNotFoundException;
import java.io.InputStream;
import java.io.PrintStream;

/**
 * A syntactic lookahead over a choice of single tokens (Name) scans it with one bit set lookup;
 * the kinds of its tokens lie on both sides of 64, so the bit set spans two longs.
 */
public class LookaheadTokenSet {

  public static void main(String args[]) {
    if (args.length != 3) {
      System.err.println("Error: invalid number of arguments (" + args.length + ")");
      System.err.println("Usage: LookaheadTokenSet inputfile outputfile errorfile");
      System.exit(4);
    }
    String fn = null;
    InputStream stdInput  = null;
    PrintStream stdOutput = null;
    PrintStream stdError  = null;
    try {
      // open files and redirect standard streams to them
      fn = "input";
      stdInput = System.in;
      System.setIn(new FileInputStream(args[0]));
      fn = "output";
      stdOutput = System.out;
      System.setOut(new PrintStream(args[1]));
      fn = "error";
      stdError  = System.err;
      System.setErr(new PrintStream(args[2]));
      // parse
      LookaheadTokenSet parser = new LookaheadTokenSet(System.in);
      parser.Input();
      System.err.println("Input file parsed successfully");
    } catch (FileNotFoundException e) {
      System.err.println("FileNotFoundException opening " + fn + " file");
      System.err.println(e.getMessage());
    } catch (ParseException e) {
      System.err.println("ParseException parsing input file");
      System.err.println(e.getMessage());
    } catch (Exception e) {
      System.err.println("Exception parsing input file");
      System.err.println(e.getMessage());
    } catch (Error e) {
      System.err.println("Error parsing input file");
      System.err.println(e.getMessage());
    } finally {
      // restore standard streams
      if (stdInput  != null) System.setIn(stdInput);
      if (stdOutput != null) System.setOut(stdOutput);
      if (stdError  != null) System.setErr(stdError);
    }
  }

}
PARSER_END(LookaheadTokenSet)

SKIP : { " " | "\t" | "\n" | "\r" }

TOKEN :
{
  < ALPHA : "alpha" >
| < BETA : "beta" >
| < EQ : "=" >
| < INTEGER : ( ["0"-"9"] )+ >
}

// fillers pushing the next tokens' kinds past 63
TOKEN :
{
< F00 : "f00" >
| < F01 : "f01" >
| < F02 : "f02" >
| < F03 : "f03" >
| < F04 : "f04" >
| < F05 : "f05" >
| < F06 : "f06" >
| < F07 : "f07" >
| < F08 : "f08" >
| < F09 : "f09" >
