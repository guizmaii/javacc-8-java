| < F47 : "f47" >
| < F48 : "f48" >
| < F49 : "f49" >
| < F50 : "f50" >
| < F51 : "f51" >
| < F52 : "f52" >
| < F53 : "f53" >
| < F54 : "f54" >
| < F55 : "f55" >
| < F56 : "f56" >
| < F57 : "f57" >
| < F58 : "f58" >
| < F59 : "f59" >
| < F60 : "f60" >
| < F61 : "f61" >
| < F62 : "f62" >
| < F63 : "f63" >
}

TOKEN :
{
  < GAMMA : "gamma" >
| < DELTA : "delta" >
| < Id : ["a"-"z", "A"-"Z"] ( ["a"-"z", "A"-"Z", "0"-"9"] )* >
}

void Input() :
{}
{
  ( Item() )*
  <EOF>
}

void Item() :
{ String n, m; }
{
  LOOKAHEAD(Name() <EQ> Name())
  n = Name() <EQ> m = Name() { System.out.println("alias " + n + " of " + m); }
| LOOKAHEAD(2)
  n = Name() <EQ> <INTEGER> { System.out.println("assignment to " + n); }
| n = Name() { System.out.println("name " + n); }
}

String Name() :
{ Token t; }
{
  ( t = <ALPHA> | t = <BETA> | t = <GAMMA> | t = <DELTA> | t = <Id> )
  { return t.image; }
}
